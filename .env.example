# ——— Required (app will not work without these) ———
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ——— Optional — principal elevation (admin/staff/principal profiles only) ———
# BEACON_PRINCIPAL_EMAIL=principal@yourschool.org
# Alias (same behavior):
# BEACON_DEMO_PRINCIPAL_EMAIL=principal@yourschool.org

# Office secretary / power user login prefill (profiles.role must be admin)
# BEACON_OFFICE_ADMIN_EMAIL=office@yourschool.org
# BEACON_DEMO_OFFICE_ADMIN_EMAIL=office@yourschool.org

# Product owner inbox for pilot Suggestion button (required for live owner email)
# Suggestions go HERE — not to the principal. Principal can still read in-app.
# BEACON_FEEDBACK_TO=you@yourdomain.com
# BEACON_OWNER_EMAIL=you@yourdomain.com

# ——— Email transports (cascade: Resend → SMTP → log) ———
# Optional order override, comma-separated: resend,smtp,log
# EMAIL_TRANSPORTS=resend,smtp,log
#
# Resend (https://resend.com)
# 1. Verify domain · 2. RESEND_API_KEY on Vercel Production · 3. EMAIL_FROM on that domain
RESEND_API_KEY=
EMAIL_FROM=Your School <office@yourschool.org>
# EMAIL_REPLY_TO=office@yourschool.org
#
# SMTP fallback (school Google Workspace / Office 365 / SES SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Or: SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# Pilot owner phone push (https://ntfy.sh — open source)
# Create a secret topic name (not guessable). Install ntfy app, subscribe to the topic.
# BEACON_NTFY_URL=https://ntfy.sh/your-long-random-topic
# BEACON_NTFY_TOPIC=your-long-random-topic
# BEACON_NTFY_SERVER=https://ntfy.sh
# BEACON_NTFY_TOKEN=
# BEACON_NTFY_PRIORITY=high

# ——— Slack office / ops channel (optional) ———
# Preferred: Incoming Webhook for one channel (Slack app → Incoming Webhooks)
# BEACON_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T…/B…/…
# Optional display name on webhook posts:
# BEACON_SLACK_USERNAME=Beacon
# Alternate: Bot token + channel (chat.postMessage)
# BEACON_SLACK_BOT_TOKEN=xoxb-…
# BEACON_SLACK_CHANNEL=#office
# Used for: Comms Slack test, new announcements, pilot suggestion alerts
#
# Absolute links in emails (production should set this)
# NEXT_PUBLIC_APP_URL=https://beacon.commoncentsip.com
# Voxel campus twin (BeaconCraft) — optional external override for login/school links
# Default: integrated on same host at /craft and public tour at /craft/tour
# NEXT_PUBLIC_BEACONCRAFT_URL=https://beaconcraft.vercel.app  # legacy separate deploy only
# Server-only twin notify (must match craft SCAN_API_KEY). See docs/adr/001-campus-twin-scan-presence.md
# BEACONCRAFT_URL=https://beaconcraft.vercel.app
# BEACONCRAFT_SCAN_API_KEY=
# Optional map Beacon room UUID → craft room id (room-a101, room-gym, …)
# BEACONCRAFT_ROOM_MAP={"11111111-1111-1111-1111-111111111111":"room-a101"}

# Optional — QuickBooks Online (https://developer.intuit.com)
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://your-domain.vercel.app/api/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox

# Vercel Cron auth (billing schedules daily). Required on production/preview.
# Generate: openssl rand -hex 32
# CRON_SECRET=

# ——— Stripe (family pay portal card checkout) ———
# Dashboard: https://dashboard.stripe.com
# 1. Developers → API keys → Secret key
# 2. Developers → Webhooks → Add endpoint
#      URL: https://your-domain/api/stripe/webhook
#      Event: checkout.session.completed
# 3. Copy signing secret → STRIPE_WEBHOOK_SECRET
# Local test: stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…   # optional (Checkout is hosted; used for branding later)
# Multi-school + one Stripe account mixes funds — Checkout refuses unless:
# BEACON_STRIPE_MULTI_SCHOOL=1



# ——— Migrations (scripts/apply-migrations.mjs / npm run db:migrate) ———
# Prefer DATABASE_URL for any environment. If you use password-only, set PROJECT_REF explicitly.
# DATABASE_URL=postgresql://postgres:…@db.YOUR_REF.supabase.co:5432/postgres
# POSTGRES_PASSWORD=
# SUPABASE_DB_PASSWORD=          # alias for POSTGRES_PASSWORD
# SUPABASE_PROJECT_REF=          # required with password if not using DATABASE_URL
#   (scripts refuse to guess a project — no silent default)

# Error tracking (optional) — @sentry/nextjs is installed; init only when DSN is set.
# Server / edge: SENTRY_DSN (preferred private). Browser: NEXT_PUBLIC_SENTRY_DSN.
# reportError() always console.error's; captureException when DSN present.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Detailed /api/health readiness (header only: x-beacon-health-secret — never query string)
# BEACON_HEALTH_SECRET=long-random-string

# Durable rate limits (kiosk / device / login). Required on Vercel production/preview
# so limits apply across serverless instances. Local dev may use in-memory only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Break-glass only (not for public prod): skip Go-live fail when Upstash missing
# RATE_LIMIT_ALLOW_MEMORY=1

# Kiosk / RFID device token lifetime in days (default 90). Migration 018.
# BEACON_ACCESS_TOKEN_TTL_DAYS=90

# Optional HMAC for QuickBooks OAuth state (defaults to service role key if unset)
# BEACON_OAUTH_STATE_SECRET=

# Optional Twilio SMS (aftercare parent notify)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1…

# School local calendar day for badge attendance (IANA tz)
# BEACON_SCHOOL_TZ=America/Chicago

# ——— Playwright e2e (optional local overrides) ———
# PLAYWRIGHT_PORT=3010
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3010
# (If PLAYWRIGHT_BASE_URL is set, webServer is not started — you must serve the app yourself.)

# Platform-provided on Vercel (do not commit): VERCEL_URL, VERCEL_ENV, VERCEL_PROJECT_PRODUCTION_URL
