NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — elevate this email to principal when profile role is admin/staff
# BEACON_PRINCIPAL_EMAIL=principal@yourschool.org

# Optional — real email delivery (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Beacon <onboarding@resend.dev>

# Optional — QuickBooks Online (https://developer.intuit.com)
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://your-domain.vercel.app/api/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox

# Optional — apply migrations via scripts/apply-migrations.mjs
# DATABASE_URL=postgresql://postgres:…@db.xxx.supabase.co:5432/postgres
# POSTGRES_PASSWORD=
# SUPABASE_PROJECT_REF=
