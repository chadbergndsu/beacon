NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — elevate this email to principal when profile role is admin/staff
# BEACON_PRINCIPAL_EMAIL=principal@yourschool.org

# Product owner inbox for pilot Suggestion button (required for live owner email)
# Suggestions go HERE — not to the principal. Principal can still read in-app.
# BEACON_FEEDBACK_TO=you@yourdomain.com
# BEACON_OWNER_EMAIL=you@yourdomain.com

# ——— Email transports (cascade: Resend → SMTP → log) ———
# Optional order override, comma-separated: resend,smtp,log
# EMAIL_TRANSPORTS=resend,smtp,log
#
# Resend (https://resend.com)
# 1. Verify domain · 2. RESEND_API_KEY on Vercel Production · 3. EMAIL_FROM on that domain
RESEND_API_KEY=
EMAIL_FROM=Your School <office@yourschool.org>
# EMAIL_REPLY_TO=office@yourschool.org
#
# SMTP fallback (school Google Workspace / Office 365 / SES SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Or: SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# Pilot owner phone push (https://ntfy.sh — open source)
# Create a secret topic name (not guessable). Install ntfy app, subscribe to the topic.
# BEACON_NTFY_URL=https://ntfy.sh/your-long-random-topic
# BEACON_NTFY_TOPIC=your-long-random-topic
# BEACON_NTFY_SERVER=https://ntfy.sh
# BEACON_NTFY_TOKEN=
# BEACON_NTFY_PRIORITY=high
#
# NEXT_PUBLIC_APP_URL=https://beacon.commoncentsip.com

# Optional — QuickBooks Online (https://developer.intuit.com)
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://your-domain.vercel.app/api/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox

# Optional — apply migrations via scripts/apply-migrations.mjs
# DATABASE_URL=postgresql://postgres:…@db.xxx.supabase.co:5432/postgres
# POSTGRES_PASSWORD=
# SUPABASE_PROJECT_REF=

# Error tracking (production) — set in Vercel/host secrets, not committed
# Install @sentry/nextjs and set DSN to enable captureException via reportError()
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Detailed /api/health readiness (header only: x-beacon-health-secret)
# BEACON_HEALTH_SECRET=long-random-string

# Optional durable rate limits (kiosk / device / login). Falls back to in-memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional HMAC for QuickBooks OAuth state (defaults to service role key)
# BEACON_OAUTH_STATE_SECRET=

# Optional Twilio SMS (aftercare parent notify)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1…
